<.mn_shell title="Mgl ID" flash={@flash}>
  <article class="mn-doc">
    <h1 class="mn-h1 mn-text">ᠨᠢᠭᠡᠳᠦᠮᠡᠯ ᠪᠦᠷᠲᠦᠭᠡᠯ</h1>
    <p class="mn-lead mn-text">
      ᠨᠢᠭᠡᠳᠦᠮᠡᠯ ᠪᠦᠷᠲᠦᠭᠡᠯ ᠪᠠ ᠨᠡᠪᠲᠡᠷᠡᠯᠲᠡ ᠶᠢᠨ ᠰᠢᠰᠲ᠋ᠧᠮ᠃
    </p>
    <div class="mn-actions">
      <a href={~p"/login"} class="mn-text btn btn-primary">ᠨᠡᠪᠲᠡᠷᠡᠬᠦ</a>
      <a href={~p"/register"} class="mn-text btn">ᠪᠦᠷᠢᠳᠬᠡᠭᠦᠯᠬᠦ</a>
      <a href={~p"/account"} class="mn-text btn btn-ghost">ᠮᠢᠨᠤ ᠪᠦᠷᠲᠦᠭᠡᠯ</a>
    </div>
  </article>
</.mn_shell>
